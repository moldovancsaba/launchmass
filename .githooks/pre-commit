#!/bin/sh
# launchmass pre-commit hook — enforce documentation/version consistency.
# Install with: npm run install-hooks  (or it runs automatically after npm install)
npm run verify-docs || {
  echo "" >&2
  echo "✗ pre-commit: verify-docs failed. Fix version/doc consistency before committing." >&2
  echo "  (run 'npm run verify-docs' to see details)" >&2
  exit 1
}

npm run lint || {
  echo "" >&2
  echo "✗ pre-commit: lint failed. Fix ESLint error-level violations before committing." >&2
  echo "  (run 'npm run lint' to see details)" >&2
  exit 1
}

npm run typecheck || {
  echo "" >&2
  echo "✗ pre-commit: typecheck failed. Fix tsc --checkJs errors before committing." >&2
  echo "  (run 'npm run typecheck' to see details)" >&2
  exit 1
}

npm run scan-secrets || {
  echo "" >&2
  echo "✗ pre-commit: scan-secrets found a possible credential in staged files. Commit blocked." >&2
  echo "  (run 'npm run scan-secrets' to see details)" >&2
  exit 1
}
